# Copia este archivo a .env y llena con los datos de tu proyecto en supabase.com
# (Project Settings → API)
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_ANON_KEY

# Solo para migraciones (npm run migrate). No la usa la app en el navegador.
# Project Settings → Database → Connection string → URI
DATABASE_URL=postgresql://postgres:CONTRASENA@db.TU-PROYECTO.supabase.co:5432/postgres
